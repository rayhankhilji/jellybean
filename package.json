{
  "name": "jellybean-mcp",
  "version": "1.0.0",
  "description": "A token-frugal MCP server that gives coding agents structural understanding of a codebase — repo maps, symbol outlines, ranked search, import tracing, and parsed diagnostics, all under a hard token budget.",
  "type": "module",
  "bin": {
    "jellybean": "dist/index.js",
    "jellybean-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node scripts/run-tests.mjs",
    "pretest": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist dist-test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "agent",
    "code-intelligence",
    "token-efficient",
    "llm-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
